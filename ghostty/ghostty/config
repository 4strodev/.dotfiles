# appearance
font-family = RecMonoDuotone Nerd Font Mono
font-family = "Noto Color Emoji"
font-family-italic = RecMonoDuotone Nerd Font Mono
font-family-bold = RecMonoDuotone Nerd Font Mono
font-family-bold-italic = RecMonoDuotone Nerd Font Mono
font-size = 11
font-feature = -calt
font-feature = -liga
font-feature = -dlig
theme = "light:GitLab Light,dark:GitLab Dark"

# Cursor options
shell-integration-features = no-cursor,ssh-env
cursor-style = block

# Working directory
working-directory = home
window-inherit-working-directory = false

# Window options
## ensure no single instance is enabled. If not quickjump doesn't work
gtk-single-instance = false
confirm-close-surface = false

# terminal behavior
mouse-scroll-multiplier = discrete:0.9
