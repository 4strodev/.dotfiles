#compdef screen_rotate

_screen_rotate_screens() {
    local -a screens
    screens=(${(f)"$(kscreen-doctor -j 2>/dev/null | jq -r '.outputs[].name' 2>/dev/null)"})
    (( ${#screens} )) || return 1
    _describe -t screens 'screen' screens
}

_screen_rotate_directions() {
    local -a directions
    directions=('1:rotate clockwise' '-1:rotate counter clockwise')
    _describe -t directions 'direction' directions
}

_screen_rotate() {
    _arguments \
        '1:screen:_screen_rotate_screens' \
        '2:direction:_screen_rotate_directions'
}
